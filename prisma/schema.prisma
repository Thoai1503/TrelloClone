generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum BoardRole {
  ADMIN
  EDITOR
  VIEWER
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model user {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  email         String?   @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  avatar_url    String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updated_at    DateTime? @db.DateTime(6)

  workspace_members workspace_member[]
  board_members     board_member[]
  created_cards     card[]             @relation("CardCreator")
  card_members      card_member[]
}

model workspace {
  id              BigInt    @id @default(autoincrement())
  name            String    @db.VarChar(150)
  description     String?   @db.Text
  backgroundColor String    @default("#0c66e4") @map("background_color") @db.Char(7)
  created_by      BigInt    @map("created_by")
  created_at      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updated_at      DateTime? @updatedAt @map("updated_at") @db.DateTime(3)
  archived_at     DateTime? @map("archived_at") @db.DateTime(3)

  members workspace_member[]
  boards  board[]

  @@index([created_by])
  @@map("workspace")
}

model workspace_member {
  workspace_id BigInt        @map("workspace_id")
  user_id      Int           @map("user_id") @db.UnsignedInt
  role         WorkspaceRole @default(MEMBER)

  joined_at DateTime @default(now()) @map("joined_at") @db.DateTime(3)

  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, user_id])
  @@index([user_id])
  @@map("workspace_member")
}

model board {
  id              BigInt    @id @default(autoincrement())
  workspace_id    BigInt    @map("workspace_id")
  created_by      BigInt    @map("created_by")
  backgroundColor String    @default("#0c66e4") @map("background_color") @db.Char(7)
  name            String    @db.VarChar(150)
  description     String?   @db.Text

  created_at      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updated_at      DateTime? @updatedAt @map("updated_at") @db.DateTime(3)
  archived_at     DateTime? @map("archived_at") @db.DateTime(3)

  workspace     workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  board_members board_member[]
  lists         list[]

  @@index([workspace_id, archived_at])

  @@index([created_by])
  @@map("board")
}

model board_member {
  board_id BigInt    @map("board_id")
  user_id  Int       @map("user_id") @db.UnsignedInt
  role     BoardRole @default(EDITOR)

  joined_at DateTime @default(now()) @map("joined_at") @db.DateTime(3)

  board board @relation(fields: [board_id], references: [id], onDelete: Cascade)
  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([board_id, user_id])
  @@index([user_id])
  @@map("board_members")
}

model list {
  id       BigInt @id @default(autoincrement())
  board_id BigInt @map("board_id")

  name     String  @db.VarChar(150)
  position Decimal @default(1000) @db.Decimal(20, 6)

  created_at  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updated_at  DateTime? @updatedAt @map("updated_at") @db.DateTime(3)
  archived_at DateTime? @map("archived_at") @db.DateTime(3)

  board board  @relation(fields: [board_id], references: [id], onDelete: Cascade)
  cards card[]

  @@index([board_id, position])
  @@map("lists")
}

// ==========================================
// CARD / TASK
// ==========================================

model card {
  id         BigInt @id @default(autoincrement())
  list_id    BigInt @map("list_id")
  created_by Int    @map("created_by") @db.UnsignedInt

  title       String       @db.VarChar(255)
  description String?      @db.Text
  position    Decimal      @default(1000) @db.Decimal(20, 6)
  priority    CardPriority @default(MEDIUM)
  is_completed Boolean     @default(false) @map("is_completed")

  start_date   DateTime? @map("start_date") @db.DateTime(3)
  due_date     DateTime? @map("due_date") @db.DateTime(3)
  completed_at DateTime? @map("completed_at") @db.DateTime(3)
  created_at   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updated_at   DateTime? @updatedAt @map("updated_at") @db.DateTime(3)
  archived_at  DateTime? @map("archived_at") @db.DateTime(3)

  list    list          @relation(fields: [list_id], references: [id], onDelete: Cascade)
  creator user          @relation("CardCreator", fields: [created_by], references: [id], onDelete: Restrict)
  members card_member[]

  @@index([list_id, position])
  @@index([created_by])
  @@index([due_date])
  @@index([updated_at])
  @@map("cards")
}

model card_member {
  card_id BigInt @map("card_id")
  user_id Int    @map("user_id") @db.UnsignedInt

  assigned_at DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  card card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([card_id, user_id])
  @@index([user_id])
  @@map("card_members")
}
